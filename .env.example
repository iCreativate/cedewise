# Copy to `.env` and fill in values. Next.js exposes only `NEXT_PUBLIC_*` to the browser.

# PostgreSQL (Prisma) — used by /api/risks and NextAuth credentials. If unset or unreachable, GET /api/risks returns [] and writes are 503.
DATABASE_URL=

# NextAuth — set NEXTAUTH_SECRET in production (e.g. openssl rand -base64 32). Dev falls back to an insecure default if omitted.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google Maps Platform (https://console.cloud.google.com/google/maps-apis/credentials)
# Enable: Maps JavaScript API, Maps Embed API, Maps SDK (optional: Visualization library for heat overlay)
# When NEXT_PUBLIC_GOOGLE_MAPS_API_KEY is set, /dashboard/heatmap uses Google Maps + Advanced Markers (beta).
# Otherwise it falls back to Leaflet + CARTO light tiles.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for Advanced Markers — use DEMO_MAP_ID for testing or create one in Cloud Console → Map Management
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID
